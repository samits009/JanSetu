# JanSetu Production Environment Variables Template
# Copy to .env and configure real credentials via AWS Secrets Manager or secure vault

# Primary Authoritative Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://jansetu_user:jansetu_password@127.0.0.1:5433/jansetu_db
TEST_DATABASE_URL=postgresql+asyncpg://jansetu_user:jansetu_password@127.0.0.1:5433/jansetu_test

# Session & Crypto
SESSION_SECRET=
SECRET_KEY=

# Google Gemini AI Integration
GEMINI_API_KEY=
AI_API_KEY=

# Real Google OAuth 2.0 / OpenID Connect Credentials
# Obtain from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local: http://localhost:8000/api/auth/google/callback
# Production: https://api.jansetu.in/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# AWS Infrastructure & Storage
AWS_REGION=ap-south-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# CORS & Application URLs
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://jansetu.in,https://app.jansetu.in

# Development Flags (Set to false or omit in production)
DEV_MOCK_ADMIN_AUTH=false
DEV_DEMO_AUTH=false
