# Windows host -> Docker PostgreSQL published port
DATABASE_URL=postgresql+asyncpg://jansetu_user:jansetu_password@127.0.0.1:5433/jansetu_db
TEST_DATABASE_URL=postgresql+asyncpg://jansetu_user:jansetu_password@127.0.0.1:5433/jansetu_test
SECRET_KEY=your-secret-key-here
AI_API_KEY=your-gemini-api-key-here
# DEV_MOCK_ADMIN_AUTH=true enables mock admin identity for local development ONLY.
# Set to false (or omit) in production — system will fail closed with 503 if no real auth is configured.
DEV_MOCK_ADMIN_AUTH=true
DEV_DEMO_AUTH=true
